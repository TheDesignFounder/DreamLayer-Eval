{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dreamlayer:bundle:1",
  "title": "DreamLayer bundle manifest v1",
  "type": "object",
  "required": [
    "schema_version",
    "experiment_id",
    "files"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "experiment_id": {
      "type": "string",
      "minLength": 1
    },
    "files": {
      "type": "object",
      "required": [
        "records.jsonl",
        "results.csv",
        "provenance.json"
      ],
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    }
  },
  "additionalProperties": false
}
